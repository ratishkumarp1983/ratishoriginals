# ---------------------------------------------------------------------------
# Ratish Originals (RatishOriginals) - environment configuration
# Copy to `.env` and fill in. Local-first defaults let the app run with zero
# paid credentials; each service swaps to a real provider by changing its vars.
# ---------------------------------------------------------------------------

# --- Core ---
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=Ratish Originals

# Trust client-IP headers (cf-connecting-ip / x-real-ip / X-Forwarded-For) for
# rate limiting. Leave false unless the app runs behind a reverse proxy or CDN
# that sets a real client IP and strips client-supplied copies. Set true in
# production behind that proxy so per-IP limits (incl. the login throttle) work;
# leaving it true on a directly-exposed instance lets a forged header bypass them.
TRUST_PROXY=false

# --- Database (PostgreSQL) ---
# Matches docker-compose.yml. Start it with: docker compose up -d
DATABASE_URL=postgresql://ratishoriginals:ratishoriginals@localhost:5544/ratishoriginals?schema=public

# --- Auth.js ---
# Generate a secret with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=dev-only-change-me-please-0123456789abcdef
AUTH_TRUST_HOST=true
# Google OAuth (leave blank to disable the Google button in dev)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Storage adapter ---
# STORAGE_DRIVER=local  -> files under STORAGE_LOCAL_DIR, served via signed app routes
# STORAGE_DRIVER=r2     -> Cloudflare R2 (S3-compatible)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
STORAGE_SIGNED_URL_TTL=30
# R2 / S3 (only when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# --- Payments adapter (Razorpay) ---
# PAYMENTS_DRIVER=mock     -> in-process gateway, no network, deterministic
# PAYMENTS_DRIVER=razorpay -> live/test Razorpay
PAYMENTS_DRIVER=mock
PAYMENTS_CURRENCY=INR
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Virus scan adapter ---
# SCAN_DRIVER=stub  -> extension/size checks only (dev)
# SCAN_DRIVER=clamav -> ClamAV over TCP (prod)
SCAN_DRIVER=stub
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Email adapter ---
# EMAIL_DRIVER=console -> logs to server console (dev)
# EMAIL_DRIVER=resend  -> Resend API (prod)
EMAIL_DRIVER=console
EMAIL_FROM=Ratish Originals <no-reply@localhost>
RESEND_API_KEY=

# --- Cache / rate limiting (Redis) ---
# Optional in dev; falls back to an in-memory limiter when unset.
REDIS_URL=redis://localhost:6379

# --- Bot protection (Cloudflare Turnstile) ---
# Leave blank in dev to bypass; set both to enforce.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Observability (optional; leave blank to disable) ---
# Sentry error monitoring. SENTRY_DSN is server-side; NEXT_PUBLIC_SENTRY_DSN is
# the browser DSN (usually the same value). With both blank, Sentry never inits.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=
# PostHog product analytics. Blank key disables it. Host is your region's ingest
# endpoint (https://us.i.posthog.com or https://eu.i.posthog.com).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Bootstrap admin (used by the seed script) ---
ADMIN_EMAIL=admin@ratishoriginals.local
ADMIN_PASSWORD=ChangeMe-Admin-123456
